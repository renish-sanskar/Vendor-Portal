 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Purchase Order: {{ doc.name }}</title>\n    <style>\n        /* =========================================================\n           WKHTMLTOPDF SAFETY RULES & ENGINE FIXES\n           ========================================================= */\n        \n        /* RULE 4: The \"Keep Together\" Rule */\n        .keep-together {\n            page-break-inside: avoid !important;\n            break-inside: avoid !important;\n        }\n\n        /* RULE 1: The Anti-Squish Table Rule */\n        .wk-table {\n            width: 100%;\n            border-collapse: separate !important;\n            border-spacing: 0 !important;\n            border-top: 1px solid #cbd5e1;\n            border-left: 1px solid #cbd5e1;\n            margin-bottom: 25px;\n            background-color: transparent;\n        }\n        \n        .wk-table th, .wk-table td {\n            border-bottom: 1px solid #cbd5e1;\n            border-right: 1px solid #cbd5e1;\n            padding: 14px 16px;\n            text-align: left;\n            font-size: 9.5pt;\n        }\n\n        /* Alternating row colors for beauty */\n        .wk-table tbody tr.wk-row:nth-child(even) td {\n            background-color: #f8fafc;\n        }\n\n        /* RULE 1 FIX: Manual border stripping */\n        .wk-table th:last-child, \n        .wk-table td:last-child {\n            border-right: none;\n        }\n        .wk-table tbody tr:last-child td {\n            border-bottom: none;\n        }\n\n        /* RULE 1 FIX: Apply page-break-inside STRICTLY to <tr> */\n        .wk-row {\n            page-break-inside: avoid !important;\n        }\n\n        /* RULE 2: The Repeating Header Rule */\n        .wk-table thead {\n            display: table-header-group;\n        }\n        \n        .wk-table th {\n            background-color: #1e293b; /* Deep slate header */\n            color: #ffffff;\n            font-weight: 600;\n            text-transform: uppercase;\n            font-size: 8.5pt;\n            letter-spacing: 0.05em;\n        }\n\n        /* =========================================================\n           MODERN STYLING & LAYOUT (PROPER & BEAUTIFUL)\n           ========================================================= */\n\n        body {\n            font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n            font-size: 10pt;\n            color: #334155;\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n            background-color: #ffffff;\n        }\n\n        /* Brand Accent Bar at the very top */\n        .top-accent-bar {\n            height: 8px;\n            background-color: #2563eb; /* Royal Blue */\n            width: 100%;\n            margin-bottom: 25px;\n        }\n\n        .content-wrapper {\n            padding: 0 30px 30px 30px;\n        }\n\n        .document-header {\n            display: table;\n            width: 100%;\n            margin-bottom: 35px;\n        }\n\n        .header-col {\n            display: table-cell;\n            vertical-align: top;\n            width: 50%;\n        }\n\n        .header-col-right {\n            text-align: right;\n        }\n\n        .company-name {\n            font-size: 18pt;\n            font-weight: 800;\n            color: #0f172a;\n            letter-spacing: -0.5px;\n            margin-bottom: 5px;\n        }\n\n        .company-details {\n            font-size: 9.5pt;\n            color: #64748b;\n            line-height: 1.4;\n        }\n\n        h1 {\n            margin: 0 0 10px 0;\n            color: #2563eb;\n            font-size: 28pt;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: -1px;\n            line-height: 1;\n        }\n\n        .po-meta-box {\n            display: inline-block;\n            background-color: #f1f5f9;\n            padding: 10px 15px;\n            border-radius: 6px;\n            border: 1px solid #e2e8f0;\n            text-align: right;\n            min-width: 200px;\n        }\n\n        .po-meta {\n            font-size: 10pt;\n            color: #475569;\n            margin-bottom: 4px;\n        }\n        .po-meta:last-child { margin-bottom: 0; }\n        .po-meta strong { color: #0f172a; }\n\n        .info-grid {\n            display: table;\n            width: 100%;\n            margin-bottom: 35px;\n        }\n\n        .info-cell {\n            display: table-cell;\n            width: 50%;\n            vertical-align: top;\n        }\n\n        .info-cell-left { padding-right: 15px; }\n        .info-cell-right { padding-left: 15px; }\n\n        .info-box {\n            background-color: #ffffff;\n            border: 1px solid #cbd5e1;\n            border-top: 4px solid #94a3b8;\n            padding: 20px;\n            border-radius: 6px;\n            height: 100%;\n            box-sizing: border-box;\n        }\n\n        .info-label {\n            font-size: 8.5pt;\n            text-transform: uppercase;\n            color: #64748b;\n            font-weight: 700;\n            letter-spacing: 0.05em;\n            margin-bottom: 12px;\n            display: block;\n            border-bottom: 1px solid #e2e8f0;\n            padding-bottom: 6px;\n        }\n        \n        .badge {\n            display: inline-block;\n            padding: 3px 10px;\n            border-radius: 12px;\n            font-size: 8pt;\n            font-weight: 700;\n            background-color: #dbeafe;\n            color: #1e40af;\n            text-transform: uppercase;\n            vertical-align: middle;\n            border: 1px solid #bfdbfe;\n        }\n\n        .alert-danger {\n            color: #991b1b;\n            background-color: #fef2f2;\n            border-left: 4px solid #ef4444;\n            padding: 12px 15px;\n            margin-top: 15px;\n            border-radius: 0 4px 4px 0;\n            font-size: 9pt;\n            font-weight: 500;\n        }\n\n        .section-title {\n            font-size: 14pt;\n            color: #0f172a;\n            margin: 0 0 15px 0;\n            font-weight: 700;\n            border-bottom: 2px solid #e2e8f0;\n            padding-bottom: 8px;\n        }\n\n        .totals-box {\n            width: 320px;\n            float: right;\n            border: 1px solid #cbd5e1;\n            border-radius: 6px;\n            background-color: #ffffff;\n            overflow: hidden;\n        }\n\n        .totals-row {\n            padding: 12px 20px;\n            display: table;\n            width: 100%;\n            box-sizing: border-box;\n            border-bottom: 1px solid #e2e8f0;\n        }\n\n        .totals-row:last-child {\n            border-bottom: none;\n            background-color: #2563eb !important; /* Brand Blue */\n            color: #ffffff !important;\n            -webkit-print-color-adjust: exact;\n        }\n\n        .totals-row:last-child .totals-label,\n        .totals-row:last-child .totals-value {\n            color: #ffffff !important;\n            font-size: 13pt;\n        }\n\n        .totals-label {\n            display: table-cell;\n            text-align: left;\n            font-weight: 600;\n            color: #475569;\n        }\n\n        .totals-value {\n            display: table-cell;\n            text-align: right;\n            font-weight: 700;\n            color: #0f172a;\n        }\n        \n        .clearfix::after {\n            content: \"\";\n            clear: both;\n            display: table;\n        }\n\n        /* Footer / Signatures */\n        .footer-grid {\n            display: table;\n            width: 100%;\n            margin-top: 50px;\n        }\n        .footer-cell {\n            display: table-cell;\n            vertical-align: bottom;\n        }\n        .terms-box {\n            font-size: 8.5pt;\n            color: #64748b;\n            padding-right: 40px;\n        }\n        .terms-box strong {\n            color: #334155;\n            display: block;\n            margin-bottom: 5px;\n            font-size: 9.5pt;\n        }\n        .signature-box {\n            width: 250px;\n            text-align: center;\n        }\n        .signature-line {\n            border-top: 1px solid #0f172a;\n            padding-top: 8px;\n            font-weight: 600;\n            font-size: 10pt;\n            color: #0f172a;\n        }\n        \n        /* Master wrapper to ensure no conflicts with wkhtmltopdf table math */\n        .master-wrapper {\n            width: 100%;\n            border-spacing: 0;\n            border-collapse: separate;\n            border: none;\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"top-accent-bar\"></div>\n\n    <!-- RULE 3 FIX: The Bulletproof Watermark Master Table -->\n    <table class=\"master-wrapper\">\n        <thead style=\"display: table-header-group; border: none;\">\n            <tr>\n                <th style=\"border: none; padding: 0; position: relative;\">\n                    <!-- OVERLAY WATERMARK FIX: z-index 50 overlays the document. \n                         Opacity 0.12 ensures it doesn't block reading. pointer-events: none allows clicking (if digital). -->\n                    <div style=\"position: absolute; top: 400px; left: 0; width: 100%; text-align: center; z-index: 50; opacity: 0.12; pointer-events: none;\">\n                        <img src=\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 600'%3E%3Ctext x='50%25' y='50%25' text-anchor='middle' dominant-baseline='middle' font-family='Arial, sans-serif' font-size='84px' font-weight='900' fill='%230f172a' transform='rotate(-35, 400, 300)' letter-spacing='10px'%3EVENDOR PORTAL%3C/text%3E%3C/svg%3E\" alt=\"watermark\" style=\"width: 100%; max-width: 800px;\" />\n                    </div>\n                </th>\n            </tr>\n        </thead>\n        \n        <tbody style=\"border: none;\">\n            <tr>\n                <td style=\"border: none; padding: 0;\">\n                    \n                    <div class=\"content-wrapper\">\n                        <!-- ============================================== -->\n                        <!-- BEGIN DOCUMENT CONTENT FLOW                    -->\n                        <!-- ============================================== -->\n\n                        <!-- HEADER SECTION -->\n                        <div class=\"document-header keep-together\">\n                            <div class=\"header-col\">\n                                <div class=\"company-name\">Sanskar Technologies Pvt Ltd</div>\n                                <div class=\"company-details\">\n                                    123 Innovation Drive, Tech Park<br>\n                                    Mumbai, MH 400001, India<br>\n                                    GSTIN: 27AAAAA0000A1Z5\n                                </div>\n                            </div>\n                            <div class=\"header-col header-col-right\">\n                                <h1>Purchase Order</h1>\n                                <div class=\"po-meta-box\">\n                                    <div class=\"po-meta\">PO Number: <strong>{{ doc.name }}</strong></div>\n                                    <div class=\"po-meta\">Date: <strong>{{ doc.get_formatted(\"transaction_date\") }}</strong></div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- SUPPLIER & METADATA SECTION -->\n                        <div class=\"info-grid keep-together\">\n                            <div class=\"info-cell info-cell-left\">\n                                <div class=\"info-box\">\n                                    <span class=\"info-label\">Vendor Details</span>\n                                    <strong style=\"font-size: 13pt; color: #0f172a; display: block; margin-bottom: 10px;\">{{ doc.supplier_name }}</strong>\n                                    \n                                    {% set supplier_doc = frappe.get_doc(\"Supplier\", doc.supplier) %}\n                                    <div style=\"color: #475569; margin-bottom: 6px;\">\n                                        <strong>Category:</strong> <span class=\"badge\">{{ supplier_doc.custom_vendor_category or 'Standard' }}</span>\n                                    </div>\n                                    \n                                    {% set raw_rating = supplier_doc.custom_vendor_rating %}\n                                    {% set rating_5 = (raw_rating * 5) if raw_rating else 0 %}\n                                    \n                                    {# --- Supplier Scorecard (ERPNext built-in) --- #}\n                                    {% set scorecard = frappe.get_all(\"Supplier Scorecard\", filters={\"supplier\": doc.supplier}, fields=[\"supplier_score\", \"status\", \"indicator_color\"], limit=1) %}\n                                    {% if scorecard %}\n                                    {% set sc = scorecard[0] %}\n                                    <div style=\"color: #475569; margin-bottom: 6px;\">\n                                        {{ sc | scorecard_badge }}\n                                    </div>\n                                    {% endif %}\n                                    \n                                    <div style=\"color: #475569;\">\n                                        <strong>Rating:</strong> <span style=\"color: #eab308; letter-spacing: 2px;\">{{ raw_rating | stars }}</span> ({{ rating_5 | round(1) }} / 5)\n                                    </div>\n                                    \n                                    {% if rating_5 and rating_5 < 3 %}\n                                    <div class=\"alert-danger\">\n                                        <strong>\u26a0\ufe0f Caution: Low-rated vendor.</strong><br>\n                                        Please verify all terms before fulfillment.\n                                    </div>\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"info-cell info-cell-right\">\n                                <div class=\"info-box\" style=\"border-top-color: #cbd5e1;\">\n                                    <span class=\"info-label\">Shipping & Delivery</span>\n                                    <div style=\"color: #475569; line-height: 1.6;\">\n                                        <strong style=\"color: #334155;\">Deliver To:</strong><br>\n                                        {{ doc.shipping_address_display or 'Default Warehouse' }}<br>\n                                        <br>\n                                        <strong style=\"color: #334155;\">Required Delivery By:</strong><br>\n                                        <span style=\"font-size: 11pt; font-weight: 600; color: #0f172a;\">{{ doc.get_formatted(\"schedule_date\") }}</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- ITEMS TABLE SECTION -->\n                        <div class=\"keep-together\">\n                            <h4 class=\"section-title\">Itemized Details</h4>\n                        </div>\n\n                        <table class=\"wk-table\">\n                            <thead>\n                                <tr>\n                                    <th style=\"width: 5%;\">#</th>\n                                    <th style=\"width: 15%;\">Item Code</th>\n                                    <th style=\"width: 35%;\">Description</th>\n                                    <th style=\"width: 10%; text-align: right;\">Qty</th>\n                                    <th style=\"width: 15%; text-align: right;\">Rate</th>\n                                    <th style=\"width: 20%; text-align: right;\">Amount</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                {% for item in doc.items %}\n                                <tr class=\"wk-row\">\n                                    <td style=\"color: #94a3b8;\">{{ loop.index }}</td>\n                                    <td style=\"color: #475569; font-family: monospace; font-size: 9pt;\">{{ item.item_code }}</td>\n                                    <td>\n                                        <strong style=\"color: #0f172a;\">{{ item.item_name }}</strong>\n                                        {% if item.description and item.description != item.item_name %}\n                                        <div style=\"font-size: 8.5pt; color: #64748b; margin-top: 4px; line-height: 1.3;\">{{ item.description }}</div>\n                                        {% endif %}\n                                    </td>\n                                    <td style=\"text-align: right; font-weight: 600; color: #334155;\">{{ item.qty }}</td>\n                                    \n                                    <td style=\"text-align: right; color: #475569;\">\n                                        {{ item.get_formatted(\"rate\") }}\n                                    </td>\n                                    <td style=\"text-align: right;\">\n                                        <strong style=\"color: #0f172a;\">\n                                            {{ item.get_formatted(\"amount\") }}\n                                        </strong>\n                                    </td>\n                                </tr>\n                                {% endfor %}\n                            </tbody>\n                        </table>\n                        \n                        <!-- TOTALS SECTION -->\n                        <div class=\"clearfix keep-together\" style=\"margin-top: 20px;\">\n                            <div class=\"totals-box\">\n                                <div class=\"totals-row\">\n                                    <div class=\"totals-label\">Net Total</div>\n                                    <div class=\"totals-value\">\n                                        {{ doc.get_formatted(\"net_total\") }}\n                                    </div>\n                                </div>\n                                <div class=\"totals-row\">\n                                    <div class=\"totals-label\">Taxes & Charges</div>\n                                    <div class=\"totals-value\">\n                                        {{ doc.get_formatted(\"total_taxes_and_charges\") }}\n                                    </div>\n                                </div>\n                                <div class=\"totals-row\">\n                                    <div class=\"totals-label\">Grand Total</div>\n                                    <div class=\"totals-value\">\n                                        {{ doc.get_formatted(\"grand_total\") }}\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- FOOTER / SIGNATURE SECTION -->\n                        <div class=\"footer-grid keep-together\">\n                            <div class=\"footer-cell terms-box\">\n                                <strong>Terms & Conditions</strong>\n                                1. Subject to standard company terms and jurisdiction.<br>\n                                2. Ensure PO number is quoted on all invoices and dispatch notes.<br>\n                                3. Defective items will be returned at supplier's cost.\n                            </div>\n                            <div class=\"footer-cell signature-box\">\n                                <div class=\"signature-line\">Authorized Signatory</div>\n                                <div style=\"font-size: 8.5pt; color: #64748b; margin-top: 4px;\">Sanskar Technologies Pvt Ltd</div>\n                            </div>\n                        </div>\n\n                        <!-- ============================================== -->\n                        <!-- END DOCUMENT CONTENT FLOW                      -->\n                        <!-- ============================================== -->\n                    </div>\n\n                </td>\n            </tr>\n        </tbody>\n    </table>\n\n</body>\n</html>",
